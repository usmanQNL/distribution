# syntax=docker/dockerfile:1
# Docker image for a Python app. Written by the distribution skill (generate.sh) when targets.docker is true in distribution.json.
# Fill in CMD (and EXPOSE for a web app) for this project, like ENTRY in packaging/app.spec.
# Build: docker build -t app .    Run: docker run --rm -p 8000:8000 app

# Mix projects with a bundled frontend: uncomment this stage, set the folder, and the COPY --from line below.
# FROM node:24-slim AS frontend
# WORKDIR /src
# COPY frontend/ .
# RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

# Dependencies first, so a code change does not reinstall them.
# requirements.txt wins; otherwise the [project] dependencies in pyproject.toml are installed (not the project itself).
COPY requirements.tx[t] pyproject.tom[l] ./
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; \
    elif [ -f pyproject.toml ]; then \
      python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml','rb')).get('project',{}).get('dependencies',[])))" > /tmp/deps.txt \
      && pip install -r /tmp/deps.txt; \
    fi

COPY . .
# COPY --from=frontend /src/dist ./frontend/dist

RUN useradd --create-home --uid 10001 app
USER app

# Pick the line for this project and delete the others:
#   No framework (CLI):  CMD ["python", "main.py"]
#   Flask:               CMD ["python", "-m", "flask", "--app", "app", "run", "--host", "0.0.0.0", "--port", "8000"]
#                        (for production add gunicorn to requirements and use ["gunicorn", "-b", "0.0.0.0:8000", "app:app"])
#   FastAPI:             CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
#   Streamlit:           CMD ["streamlit", "run", "app.py", "--server.address", "0.0.0.0", "--server.port", "8000"]
# EXPOSE 8000
CMD ["python", "main.py"]
